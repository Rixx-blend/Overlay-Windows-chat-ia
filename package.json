{
  "name": "overlay-ia",
  "version": "1.0.72",
  "description": "Overlay de chat IA en verre liquide pour Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rixx.overlayia",
    "productName": "OverlayIA",
    "artifactName": "OverlayIA-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "computer-use.js",
      "preload.js",
      "rembg.js",
      "renderer/**/*",
      "computer_use/**/*"
    ],
    "asarUnpack": [
      "**/uiohook-napi/**",
      "computer_use/**/*"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "Rixx-blend",
      "repo": "Overlay-Windows-chat-ia",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OverlayIA"
    }
  },
  "dependencies": {
    "uiohook-napi": "^1.5.0",
    "electron-updater": "^6.3.0",
    "onnxruntime-node": "^1.22.0",
    "sharp": "^0.34.5"
  }
}
